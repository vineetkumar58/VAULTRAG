# Copy this to .env for local testing (never commit the real .env file)

# --- AWS ---
AWS_REGION=ap-south-1

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Pinecone ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_HOST=your-index-xxxxx.svc.your-region.pinecone.io

# --- Auth ---
JWT_SECRET=generate-a-long-random-string-here

# --- DynamoDB table names (must match what Terraform creates) ---
TENANTS_TABLE=vaultrag-dev-Tenants
USERS_TABLE=vaultrag-dev-Users
INVITES_TABLE=vaultrag-dev-Invites
HISTORY_TABLE=vaultrag-dev-ConversationHistory
